{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "voxloom",
  "version": "0.1.8",
  "identifier": "org.voxloom.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VoxLoom",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "backgroundColor": "#121616"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; media-src asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "resources": {
      "../worker/engine.py": "worker/engine.py",
      "../worker/notes.py": "worker/notes.py",
      "../worker/export_docx.py": "worker/export_docx.py",
      "../worker/provision.py": "worker/provision.py",
      "../worker/requirements.txt": "worker/requirements.txt",
      "../worker/requirements.lock.txt": "worker/requirements.lock.txt",
      "../models/manifest.json": "models/manifest.json",
      "../scripts/setup-runtimes.sh": "scripts/setup-runtimes.sh",
      "../scripts/patch-llama-completion.py": "scripts/patch-llama-completion.py",
      "../docs/MODEL_SOURCES.md": "docs/MODEL_SOURCES.md",
      "../worker/setup_runtime.py": "worker/setup_runtime.py",
      "engines/": "engines/"
    },
    "category": "Productivity",
    "shortDescription": "Your meetings, remembered. Entirely on your device.",
    "linux": {
      "deb": {
        "depends": [
          "ffmpeg",
          "pulseaudio-utils",
          "python3",
          "python3-venv",
          "libgomp1",
          "libstdc++6"
        ],
        "desktopTemplate": "desktop.template"
      }
    },
    "icon": [
      "icons/icon.png"
    ]
  }
}
